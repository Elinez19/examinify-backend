{
  "name": "examinify-backend",
  "version": "1.0.0",
  "description": "Examinify Backend API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:bootstrap": "ts-node --transpile-only ./src/db/seeds/bootstrap.seed.ts",
    "db:seed:demo": "ts-node --transpile-only ./src/db/seeds/demo.seed.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@google/genai": "^3.6.1",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "papaparse": "^5.7.1",
    "resend": "^6.39.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
